# Copy this file to .env (which git ignores) and fill it in for local runs.
# On GitHub, set the same names as repository secrets instead.
FRIEND_NAME=Firstname
PROFILE_URL=https://www.goodreads.com/user/show/12345678-firstname-lastname
# Only needed to actually send email (not for --dry-run):
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
ALERT_TO=
